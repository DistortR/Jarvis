[Unit]
Description=Jarvis wake-word assistant
PartOf=graphical-session.target
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
WorkingDirectory=%Y
Environment=JARVIS_DESKTOP_STATUS=1
ExecStart="%Y/.wake-venv/bin/python" -B jarvis.py --wake
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
